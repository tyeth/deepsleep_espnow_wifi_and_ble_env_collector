+    envhub_bt_fault_snapshot(words);
+    for (size_t i = 0; i < 8; i++) {
+        values[i] = mp_obj_new_int_from_uint(words[i]);
+    }
+    values[8] = mp_obj_new_bool(bt_is_ready());
+    return mp_obj_new_tuple(9, values);
+}
