+static mp_obj_t envhub_fault_arm(mp_obj_t value) {
+    mp_int_t stage = mp_obj_get_int(value);
+    if (stage != 0 && stage != 3 && stage != 4 && stage != 5) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Invalid stage"));
+    }
+    if (bt_is_ready()) {
