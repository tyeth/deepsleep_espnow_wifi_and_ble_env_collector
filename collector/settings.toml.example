# Copy to settings.toml on the CIRCUITPY drive and fill in.
# CircuitPython auto-connects when CIRCUITPY_WIFI_SSID is set.
CIRCUITPY_WIFI_SSID = "your-ssid"
CIRCUITPY_WIFI_PASSWORD = "your-password"

# Optional: keep the USB drive name obvious
# CIRCUITPY_WEB_API_PASSWORD = ""

# CircuitPython's own BLE workflow advertises as CIRCUITPY{mac} from the same
# adapter as our portal, with its file-transfer GATT: leave it on and clients
# can be handed the wrong service set, and the adapter name reverts to
# CIRCUITPYxxxx whenever it re-advertises. The hub also turns it off at
# runtime, but this stops it ever starting.
CIRCUITPY_BLE_WORKFLOW = false
